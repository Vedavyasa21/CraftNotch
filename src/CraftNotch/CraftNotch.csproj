<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>CraftNotch</AssemblyName>
    <RootNamespace>CraftNotch</RootNamespace>
    <ApplicationTitle>CraftNotch</ApplicationTitle>
    <Product>CraftNotch — Dynamic Island &amp; Desktop Notch for Windows</Product>
    <Version>1.0.0</Version>
    <Authors>Vedant</Authors>
  </PropertyGroup>

</Project>
