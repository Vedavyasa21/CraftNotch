<Window x:Class="ReNotchPixel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReNotchPixel"
        xmlns:controls="clr-namespace:ReNotchPixel.Controls"
        xmlns:models="clr-namespace:ReNotchPixel.Models"
        mc:Ignorable="d"
        Title="ReNotchPixel"
        Width="500" Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <!-- Glass styling & colors -->
        <Color x:Key="IslandBgColor">#E60C0D12</Color>
        <Color x:Key="IslandBorderColor">#2AFFFFFF</Color>
        <Color x:Key="AccentMint">#34D399</Color>
        <Color x:Key="AccentBlue">#60A5FA</Color>
        <Color x:Key="AccentPurple">#A78BFA</Color>
        <Color x:Key="TextPrimary">#F9FAFB</Color>
        <Color x:Key="TextSecondary">#9CA3AF</Color>

        <!-- Converters and Styles -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                                <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconActionButton" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Slider -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#34D399"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#34D399" Height="4" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Width="12" Height="12" Fill="#FFFFFF">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#25FFFFFF" Height="4" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root Container -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">

        <!-- Interactive Island Border Card -->
        <Border x:Name="IslandContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,0,0,0"
                Background="#EE0A0A0F"
                BorderBrush="#25FFFFFF"
                BorderThickness="1"
                ClipToBounds="True">

            <!-- Deep Liquid Glass Glow & Drop Shadow -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" Direction="270" ShadowDepth="4" Color="#000000" Opacity="0.65"/>
            </Border.Effect>

            <Grid>
                <!-- Subtle Top Bezel Highlight Reflection -->
                <Border VerticalAlignment="Top" Height="1" Background="#35FFFFFF" Opacity="0.8"/>

                <!-- ============================================== -->
                <!-- 1. IDLE MODE PILL CONTENT                     -->
                <!-- ============================================== -->
                <Grid x:Name="IdleContentGrid" Height="36" Visibility="Visible" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Time / Weather -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                        <TextBlock Text="{Binding CurrentTime}" 
                                   Foreground="#F9FAFB" 
                                   FontWeight="SemiBold" 
                                   FontSize="12" 
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Weather.Icon}" FontSize="11" Margin="6,0,2,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Weather.Temperature}" Foreground="#34D399" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Center: Desktop Pet or Agent status pill -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <controls:VirtualPetControl Kind="Cat" VerticalAlignment="Center" Margin="6,0"/>
                        <Ellipse Width="6" Height="6" Fill="{Binding Agent.StateColor, FallbackValue='#10B981'}" Margin="4,0,0,0" ToolTip="{Binding Agent.StateBadge}"/>
                    </StackPanel>

                    <!-- Right: Battery & Perf -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2">
                        <TextBlock Text="{Binding Battery, StringFormat='{}{0}%'}" 
                                   Foreground="#9CA3AF" 
                                   FontSize="11" 
                                   FontWeight="Medium" 
                                   Margin="0,0,4,0"/>
                        <TextBlock Text="⚡" 
                                   Visibility="{Binding IsCharging, Converter={StaticResource BoolToVis}}" 
                                   Foreground="#FBBF24" 
                                   FontSize="10" 
                                   Margin="0,0,2,0"/>
                        <TextBlock Text="🔋" Foreground="#9CA3AF" FontSize="11"/>
                    </StackPanel>
                </Grid>

                <!-- ============================================== -->
                <!-- 2. COMPACT MODE PILL (NOW PLAYING)            -->
                <!-- ============================================== -->
                <Grid x:Name="CompactContentGrid" Height="36" Visibility="Collapsed" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Album Art thumbnail -->
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="#22FFFFFF" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Image Source="{Binding Media.Thumbnail}" Stretch="UniformToFill"/>
                    </Border>

                    <!-- Center: Title -->
                    <TextBlock Grid.Column="1" 
                               Text="{Binding Media.Title}" 
                               Foreground="#F9FAFB" 
                               FontSize="11.5" 
                               FontWeight="SemiBold" 
                               VerticalAlignment="Center" 
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,8,0"/>

                    <!-- Right: Equalizer Waveform -->
                    <controls:WaveformVisualizer Grid.Column="2" 
                                                IsPlaying="{Binding Media.IsPlaying}" 
                                                VerticalAlignment="Center"/>
                </Grid>

                <!-- ============================================== -->
                <!-- 3. HUD TOAST PILL (VOLUME / BRIGHTNESS / CAPS)-->
                <!-- ============================================== -->
                <Grid x:Name="HudContentGrid" Height="38" Visibility="Collapsed" Margin="14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding HudIcon}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding HudTitle}" Foreground="#F9FAFB" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding HudValue}" Foreground="#9CA3AF" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                    </Grid>

                    <ProgressBar Grid.Row="1" 
                                 Value="{Binding HudProgress}" 
                                 Maximum="100" 
                                 Height="2.5" 
                                 Foreground="#34D399" 
                                 Background="#25FFFFFF" 
                                 BorderThickness="0" 
                                 Margin="0,0,0,4"/>
                </Grid>

                <!-- ============================================== -->
                <!-- 4. EXPANDED FULL CARD MODE                     -->
                <!-- ============================================== -->
                <Grid x:Name="ExpandedContentGrid" Visibility="Collapsed" Margin="14,12,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Navigation Tabs -->
                    <Border Grid.Row="0" Background="#15FFFFFF" CornerRadius="14" Padding="3" Margin="0,0,0,12">
                        <UniformGrid Rows="1">
                            <Button Content="Music" Style="{StaticResource TabButtonStyle}" Click="TabMedia_Click"/>
                            <Button Content="Widgets" Style="{StaticResource TabButtonStyle}" Click="TabWidgets_Click"/>
                            <Button Content="Controls" Style="{StaticResource TabButtonStyle}" Click="TabControls_Click"/>
                            <Button Content="Clips" Style="{StaticResource TabButtonStyle}" Click="TabClipboard_Click"/>
                            <Button Content="Shelf" Style="{StaticResource TabButtonStyle}" Click="TabShelf_Click"/>
                            <Button Content="Agents" Style="{StaticResource TabButtonStyle}" Click="TabAgents_Click"/>
                        </UniformGrid>
                    </Border>

                    <!-- TAB 1: MEDIA PANEL -->
                    <Grid x:Name="PanelMedia" Grid.Row="1" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Album Art -->
                        <Border Grid.Column="0" Width="82" Height="82" CornerRadius="14" Background="#1AFFFFFF" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="🎵" FontSize="32" Foreground="#4B5563" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding Media.Thumbnail}" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                        <!-- Media Info & Controls -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Media.Title}" Foreground="#F9FAFB" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Media.Artist}" Foreground="#9CA3AF" FontSize="12" Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>

                            <!-- Seek bar & Times -->
                            <Slider Style="{StaticResource ModernSlider}" 
                                    Value="{Binding Media.ProgressPercentage, Mode=OneWay}" 
                                    Maximum="100" 
                                    Height="16" 
                                    PreviewMouseDown="SeekSlider_MouseDown"
                                    PreviewMouseUp="SeekSlider_MouseUp"/>

                            <Grid Margin="0,2,0,8">
                                <TextBlock Text="{Binding Media.FormattedPosition}" Foreground="#6B7280" FontSize="10" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Media.FormattedDuration}" Foreground="#6B7280" FontSize="10" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Playback Control Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="⏮" Style="{StaticResource IconActionButton}" Click="BtnPrev_Click" Margin="0,0,10,0"/>
                                <Button Content="{Binding Media.IsPlaying, ConverterParameter='⏸:▶', Converter={x:Static local:PlayPauseConverter.Instance}}" 
                                        Style="{StaticResource IconActionButton}" 
                                        Width="40" Height="40" 
                                        Background="#34D399" 
                                        Foreground="#0A0A0F"
                                        FontSize="16"
                                        Click="BtnPlayPause_Click" 
                                        Margin="0,0,10,0"/>
                                <Button Content="⏭" Style="{StaticResource IconActionButton}" Click="BtnNext_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- TAB 2: WIDGETS PANEL -->
                    <Grid x:Name="PanelWidgets" Grid.Row="1" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Clock, Weather & System Performance -->
                        <Border Grid.Column="0" Background="#12FFFFFF" CornerRadius="16" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="{Binding CurrentTime}" Foreground="#F9FAFB" FontSize="24" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Weather.Icon}" FontSize="15" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Weather.Temperature}" Foreground="#34D399" FontSize="14" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{Binding CurrentDate}" Foreground="#9CA3AF" FontSize="11"/>
                                    <TextBlock Text="{Binding Weather.Condition}" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <TextBlock Text="System Performance" Foreground="#6B7280" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="CPU" Foreground="#D1D5DB" FontSize="11"/>
                                    <TextBlock Text="{Binding Cpu, StringFormat='{}{0}%'}" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Value="{Binding Cpu}" Maximum="100" Height="4" Foreground="#60A5FA" Background="#20FFFFFF" BorderThickness="0" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="RAM" Foreground="#D1D5DB" FontSize="11"/>
                                    <TextBlock Text="{Binding Ram, StringFormat='{}{0}%'}" Foreground="#A78BFA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Value="{Binding Ram}" Maximum="100" Height="4" Foreground="#A78BFA" Background="#20FFFFFF" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- Right Column: Focus / Pomodoro Timer -->
                        <Border Grid.Column="1" Background="#12FFFFFF" CornerRadius="16" Padding="12" Margin="6,0,0,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Focus Session" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding FormattedTimer}" Foreground="#F9FAFB" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,10"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="{Binding IsTimerRunning, ConverterParameter='Pause:Start', Converter={x:Static local:PlayPauseConverter.Instance}}" 
                                            Style="{StaticResource TabButtonStyle}" 
                                            Background="#25FFFFFF" 
                                            Foreground="#34D399" 
                                            Click="BtnPomodoro_Click" 
                                            Margin="0,0,6,0"/>
                                    <Button Content="Reset" 
                                            Style="{StaticResource TabButtonStyle}" 
                                            Background="#15FFFFFF" 
                                            Click="BtnResetPomodoro_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- TAB 3: QUICK CONTROLS PANEL -->
                    <Grid x:Name="PanelControls" Grid.Row="1" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <!-- Volume slider -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{Binding IsMuted, ConverterParameter='🔇:🔊', Converter={x:Static local:PlayPauseConverter.Instance}}" 
                                        Style="{StaticResource IconActionButton}" 
                                        Width="28" Height="28" 
                                        Click="BtnToggleMute_Click" 
                                        Margin="0,0,8,0"/>
                                <Slider Grid.Column="1" Style="{StaticResource ModernSlider}" Value="{Binding Volume}" Maximum="100" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat='{}{0:F0}%'}" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Quick Action Buttons Grid -->
                            <UniformGrid Rows="1" Margin="0,4,0,0">
                                <Button Style="{StaticResource TabButtonStyle}" Background="#15FFFFFF" Click="BtnToggleMic_Click" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IsMicMuted, ConverterParameter='🎙️❌ Mic:🎙️ Live', Converter={x:Static local:PlayPauseConverter.Instance}}"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource TabButtonStyle}" Background="#15FFFFFF" Click="BtnScreenshot_Click" Margin="4,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📸 Snip Screen"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource TabButtonStyle}" Background="#15FFFFFF" Click="BtnSettings_Click" Margin="4,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙️ Preferences"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>

                    <!-- TAB 4: CLIPBOARD HISTORY PANEL -->
                    <Grid x:Name="PanelClipboard" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0" 
                                 ItemsSource="{Binding ClipboardService.History}" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#12FFFFFF" CornerRadius="8" Padding="8,6" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonDown="ClipItem_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding IsUrl, ConverterParameter='🔗:📄', Converter={x:Static local:PlayPauseConverter.Instance}}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PreviewText}" Foreground="#F3F4F6" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TimeAgo}" Foreground="#6B7280" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Row="1" Content="Clear Unpinned History" Style="{StaticResource TabButtonStyle}" HorizontalAlignment="Right" Click="BtnClearClip_Click" Margin="0,4,0,0"/>
                    </Grid>

                    <!-- TAB 5: SHELF FILE DROP PANEL -->
                    <Grid x:Name="PanelShelf" Grid.Row="1" Visibility="Collapsed">
                        <Grid>
                            <!-- Drop Zone Empty Prompt -->
                            <Border BorderBrush="#35FFFFFF" BorderThickness="1.5" CornerRadius="12" Padding="14" Background="#0DFFFFFF">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShelfFiles.Count, ConverterParameter='Empty', Converter={x:Static local:CollectionEmptyConverter.Instance}}">
                                        <TextBlock Text="📥" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="Drag and drop files here" Foreground="#F3F4F6" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Holds files temporarily so you can drag them anywhere" Foreground="#9CA3AF" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Files List -->
                                    <ListBox ItemsSource="{Binding ShelfFiles}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#15FFFFFF" CornerRadius="8" Padding="8,4" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="📁" Margin="0,0,6,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="#F9FAFB" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" Foreground="#9CA3AF" FontSize="10" Margin="6,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- TAB 6: AI AGENT MONITOR PANEL -->
                    <Grid x:Name="PanelAgents" Grid.Row="1" Visibility="Collapsed">
                        <Border Background="#12FFFFFF" CornerRadius="16" Padding="14">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="🤖" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="AI Agent Live Activity" Foreground="#F9FAFB" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Background="{Binding Agent.StateColor}" CornerRadius="8" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Agent.StateBadge}" Foreground="#0A0A0F" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>

                                <Border Background="#1A000000" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Agent.Summary}" Foreground="#F3F4F6" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Agent.Detail}" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <TextBlock Text="Monitoring Antigravity &amp; Claude Code" Foreground="#6B7280" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Agent.LastActivity, StringFormat='{}Active {0:HH:mm:ss}'}" Foreground="#6B7280" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>